{
  "name": "3D Vision Observatory",
  "name_zh": "三维视觉 · 每日文献观察站",
  "site_url": "https://wang5316.github.io/paper-read",
  "display_timezone": "Asia/Shanghai",
  "user_agent": "observatory/1.0 (+https://github.com/wang5316/paper-read)",

  "publication": {
    "publish_imported_references": true,
    "publish_auto_candidates": true,
    "publish_abstracts": true,
    "publish_ai_drafts": true,
    "include_related": true
  },

  "arxiv": {
    "initial_lookback_days": 7,
    "overlap_days": 7,
    "max_window_days": 30,
    "page_size": 50,
    "max_pages_per_query": 6,
    "request_interval_seconds": 5.0,
    "timeout_seconds": 60,
    "attempts": 5,
    "revision_batch_size": 40,
    "queries": [
      {
        "id": "unsupervised-pointcloud-seg",
        "query": "(all:\"point cloud\" OR all:\"point clouds\") AND all:segmentation AND (all:unsupervised OR all:\"self-supervised\" OR all:\"label-free\" OR all:\"annotation-free\")",
        "enabled": true
      },
      {
        "id": "contrastive-learning",
        "query": "all:\"contrastive learning\" AND (all:\"point cloud\" OR all:\"Gaussian splatting\" OR all:\"3D scene\")",
        "enabled": true
      },
      {
        "id": "autonomous-driving",
        "query": "(all:\"autonomous driving\" OR all:\"self-driving\") AND (all:\"point cloud\" OR all:LiDAR OR all:occupancy) AND (all:segmentation OR all:occupancy OR all:\"object detection\")",
        "enabled": true
      },
      {
        "id": "3d-gaussian",
        "query": "(all:\"Gaussian splatting\" OR all:\"3D Gaussian\" OR all:3DGS) AND (all:segmentation OR all:semantic OR all:\"scene understanding\")",
        "enabled": true
      }
    ]
  },

  "dblp": {
    "enabled": true,
    "request_interval_seconds": 2.0,
    "timeout_seconds": 120,
    "attempts": 4,
    "page_size": 500,
    "max_pages_per_venue_year": 20,
    "lookback_years": 1,
    "recheck_completed_years_days": 30,
    "scope_prefilter": true,
    "require_track": true,
    "venues": [
      { "id": "cvpr", "name": "CVPR", "stream": "conf/cvpr", "years": [2025, 2026], "enabled": true },
      { "id": "iccv", "name": "ICCV", "stream": "conf/iccv", "years": [2025], "enabled": true },
      { "id": "eccv", "name": "ECCV", "stream": "conf/eccv", "years": [2024, 2026], "enabled": true },
      { "id": "3dv", "name": "3DV", "stream": "conf/3dim", "years": [2025, 2026], "enabled": true },
      { "id": "neurips", "name": "NeurIPS", "stream": "conf/nips", "years": [2025], "enabled": true }
    ]
  },

  "openalex": {
    "enabled": true,
    "request_interval_seconds": 1.0,
    "timeout_seconds": 60,
    "attempts": 5,
    "page_size": 200,
    "max_pages_per_journal": 30,
    "initial_lookback_days": 30,
    "overlap_days": 7,
    "max_window_days": 30,
    "types": ["article", "review"],
    "scope_prefilter": true,
    "require_track": true,
    "journals": [
      {
        "id": "tpami",
        "name": "IEEE TPAMI",
        "source_id": "S199944782",
        "issn": ["0162-8828", "1939-3539"],
        "enabled": true
      },
      {
        "id": "ijcv",
        "name": "IJCV",
        "source_id": "S25538012",
        "issn": ["0920-5691", "1573-1405"],
        "enabled": true
      },
      {
        "id": "tvcg",
        "name": "IEEE TVCG",
        "source_id": "S84775595",
        "issn": ["1077-2626", "1941-0506"],
        "enabled": true
      },
      {
        "id": "tip",
        "name": "IEEE TIP",
        "source_id": "S4210173141",
        "issn": ["1057-7149", "1941-0042"],
        "enabled": true
      },
      {
        "id": "ral",
        "name": "IEEE RA-L",
        "source_id": "S4210169774",
        "issn": ["2377-3766", "2377-3774"],
        "enabled": true
      },
      {
        "id": "isprs",
        "name": "ISPRS J. P&RS",
        "source_id": "S173339282",
        "issn": ["0924-2716", "1872-8235"],
        "enabled": true
      }
    ]
  },

  "classify": {
    "scope": {
      "id": "3d",
      "name": "3D",
      "patterns": [
        "\\b3[ -]?d\\b",
        "three[ -]dimensional",
        "point[ -]cloud",
        "\\blidar\\b",
        "\\blaser scan",
        "\\brgb[ -]?d\\b",
        "voxel",
        "gaussian splatting",
        "\\b3dgs\\b",
        "\\bnerf\\b",
        "neural radiance",
        "depth map",
        "multi[ -]?view stereo"
      ]
    },
    "task": {
      "primary": {
        "id": "semantic",
        "name": "语义分割",
        "patterns": [
          "semantic[ -]?segmentation",
          "semantic[ -]?label",
          "point[ -]cloud segmentation",
          "per[ -]point classification",
          "scene segmentation"
        ]
      },
      "adjacent": {
        "id": "adjacent",
        "name": "邻近任务",
        "patterns": [
          "instance[ -]?segmentation",
          "panoptic",
          "part[ -]?segmentation",
          "occupancy",
          "object detection",
          "3d detection",
          "scene graph",
          "scene completion",
          "novel view synthesis"
        ]
      },
      "any": {
        "id": "segmentation",
        "name": "分割(未细分)",
        "patterns": ["segment"]
      }
    },
    "tracks": [
      {
        "id": "UPC",
        "name": "无监督点云分割",
        "patterns": [
          "unsupervised",
          "self[ -]supervised",
          "semi[ -]supervised",
          "label[ -]free",
          "annotation[ -]free",
          "unlabeled",
          "without annotation"
        ],
        "requires": "point[ -]cloud|\\blidar\\b|\\b3[ -]?d\\b"
      },
      {
        "id": "CL",
        "name": "对比学习",
        "patterns": ["contrastive", "InfoNCE", "positive[ -]negative pair", "triplet loss"],
        "requires": "point[ -]cloud|\\blidar\\b|\\b3[ -]?d\\b|gaussian|scene"
      },
      {
        "id": "AD",
        "name": "自动驾驶",
        "patterns": [
          "autonomous driving",
          "self[ -]driving",
          "automated driving",
          "ego[ -]vehicle",
          "on[ -]road perception",
          "driving scene"
        ]
      },
      {
        "id": "GS",
        "name": "3D 高斯",
        "patterns": [
          "gaussian splatting",
          "3d gaussian",
          "hybrid gaussian",
          "gaussian primitives",
          "gaussian field",
          "\\b3dgs\\b"
        ],
        "requires": "semantic|segmentation|scene understanding|language|open[ -]vocab|label|grounding|instance|panoptic|edit|object|detection|understanding"
      }
    ],
    "methods": [
      { "id": "self-supervised", "patterns": ["self[ -]supervised", "self[ -]train", "masked[ -]?point", "masked[ -]?autoencod", "pre[ -]?train"] },
      { "id": "contrastive", "patterns": ["contrastive", "InfoNCE", "positive[ -]negative", "triplet"] },
      { "id": "clustering", "patterns": ["cluster"] },
      { "id": "prototype", "patterns": ["prototyp"] },
      { "id": "alignment", "patterns": ["align", "adversarial"] },
      { "id": "cross-modal", "patterns": ["cross[ -]modal", "multi[ -]?modal", "multi[ -]?view"] },
      { "id": "vision-language", "patterns": ["vision[ -]language", "\\bCLIP\\b", "language[ -]guid", "text[ -]prompt"] },
      { "id": "distillation", "patterns": ["distill"] },
      { "id": "diffusion", "patterns": ["diffusion", "generative prior"] },
      { "id": "gaussian", "patterns": ["gaussian splatting", "\\b3dgs\\b", "gaussian primitives", "gaussian"] },
      { "id": "nerf", "patterns": ["\\bnerf\\b", "neural radiance"] },
      { "id": "foundation-model", "patterns": ["foundation model", "\\bSAM\\b", "DINOv", "segment anything"] },
      { "id": "prompt-adapter", "patterns": ["\\bprompt", "adapter", "\\bLoRA\\b"] },
      { "id": "uncertainty", "patterns": ["uncertain"] },
      { "id": "active-learning", "patterns": ["active learning", "annotation[ -]free", "label[ -]free"] },
      { "id": "geometry", "patterns": ["geometr", "surface normal", "projective", "depth completion"] },
      { "id": "occupancy", "patterns": ["occupancy"] },
      { "id": "temporal", "patterns": ["temporal", "\\b4d\\b", "sequential", "multi[ -]frame"] }
    ]
  },

  "llm": {
    "enabled": true,
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "max_per_run": 8,
    "max_per_utc_day": 24,
    "max_pdf_pages": 40,
    "max_input_chars": 48000,
    "max_output_tokens": 3000,
    "request_interval_seconds": 3.0,
    "timeout_seconds": 150,
    "token_parameter": "max_completion_tokens",
    "max_consecutive_errors": 5,
    "include_imported": true,
    "regenerate_legacy_drafts": false
  },

  "topics": [
    {
      "group": "研究主题",
      "desc": "你关注的四个方向;一篇论文可以同时属于多个主题。",
      "items": [
        { "id": "upc", "name": "无监督点云分割", "desc": "无标注或少标注条件下做点云语义分割", "match": { "tracks": ["UPC"] } },
        { "id": "contrastive", "name": "对比学习", "desc": "对比损失、正负样本构造、表征学习", "match": { "tracks": ["CL"] } },
        { "id": "autodrive", "name": "自动驾驶", "desc": "车载感知、3D 检测、占用与可行驶区域", "match": { "tracks": ["AD"] } },
        { "id": "gaussian3d", "name": "3D 高斯", "desc": "3D Gaussian Splatting 的表示、语义与编辑", "match": { "tracks": ["GS"] } }
      ]
    },
    {
      "group": "方法路线",
      "desc": "按技术路线聚合;标签来自题录级自动初筛,需结合原文核对。",
      "items": [
        { "id": "selfsup", "name": "自监督与预训练", "desc": "掩码建模、预训练目标、表征迁移", "match": { "methods": ["self-supervised"] } },
        { "id": "multimodal", "name": "跨模态与视觉语言", "desc": "图文/点云对齐、CLIP 类模型、提示与适配器", "match": { "methods": ["cross-modal", "vision-language", "prompt-adapter", "foundation-model"] } },
        { "id": "efficient", "name": "蒸馏与不确定性", "desc": "知识蒸馏、不确定性建模、主动学习", "match": { "methods": ["distillation", "uncertainty", "active-learning"] } },
        { "id": "generative", "name": "生成式与神经渲染", "desc": "扩散模型、NeRF、高斯表示与数据增广", "match": { "methods": ["diffusion", "nerf", "gaussian"] } }
      ]
    },
    {
      "group": "场景与来源",
      "desc": "按数据形态、应用场景与文献来源划分。",
      "items": [
        { "id": "lidar", "name": "LiDAR 与点云", "desc": "室外激光雷达、点云与距离图像", "match": { "keywords": ["lidar", "point cloud", "range image", "depth image"] } },
        { "id": "outdoor", "name": "车载与数据集", "desc": "KITTI / nuScenes / Waymo 等驾驶场景数据", "match": { "keywords": ["kitti", "nuscenes", "waymo", "argoverse", "cityscapes", "driving"] } },
        { "id": "journal", "name": "期刊与会议论文", "desc": "发表在期刊或会议(含同时有预印本的版本)", "match": { "venue_named": true } },
        { "id": "abstractonly", "name": "仅摘要记录", "desc": "暂未获取全文,先提供摘要与出处", "match": { "abstract_only": true } }
      ]
    }
  ],

  "review": {
    "repo": "wang5316/paper-read",
    "label": "review"
  }
}
